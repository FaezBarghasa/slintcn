import { Spinner } from "../components/spinner.slint";
import { Card } from "../components/card.slint";
import { Theme } from "../tokens.slint";

export component SpinnerExamples inherits Rectangle {
    in property <bool> active: true;

    VerticalLayout {
        padding: Theme.spacing.lg;
        spacing: Theme.spacing.xl;
        alignment: start;

        // Example 1: Basic Spinner
        Card {
            VerticalLayout {
                spacing: Theme.spacing.md;
                Text { text: "1. Basic Spinner"; font-weight: Theme.typography.header_weight; }
                
                HorizontalLayout {
                    spacing: Theme.spacing.lg;
                    Spinner {}
                }
            }
        }

        // Example 2: Different Sizes
        Card {
            VerticalLayout {
                spacing: Theme.spacing.md;
                Text { text: "2. Sizes & Stroke Widths"; font-weight: Theme.typography.header_weight; }
                
                HorizontalLayout {
                    spacing: Theme.spacing.xl;
                    alignment: start;
                    Spinner { size: 24px; stroke-width: 2px; }
                    Spinner { size: 40px; stroke-width: 4px; }
                    Spinner { size: 64px; stroke-width: 6px; }
                }
            }
        }

        // Example 3: Custom Colors
        Card {
            VerticalLayout {
                spacing: Theme.spacing.md;
                Text { text: "3. Custom Colors"; font-weight: Theme.typography.header_weight; }
                
                HorizontalLayout {
                    spacing: Theme.spacing.xl;
                    alignment: start;
                    Spinner { active-brush: Theme.palette.success; }
                    Spinner { active-brush: Theme.palette.warning; }
                    Spinner { active-brush: Theme.palette.critical; }
                }
            }
        }
    }
}
