import { Switch } from "../components/switch.slint";
import { Card } from "../components/card.slint";
import { Theme } from "../tokens.slint";

export component SwitchExamples inherits Rectangle {
    in property <bool> active: true;

    VerticalLayout {
        padding: Theme.spacing.lg;
        spacing: Theme.spacing.xl;
        alignment: start;

        // Example 1: Basic Switches
        Card {
            VerticalLayout {
                spacing: Theme.spacing.md;
                Text { text: "1. Basic Switches"; font-weight: Theme.typography.header_weight; }
                
                HorizontalLayout {
                    spacing: Theme.spacing.lg;
                    Switch {}
                    Switch { checked: true; }
                }
            }
        }

        // Example 2: Disabled States
        Card {
            VerticalLayout {
                spacing: Theme.spacing.md;
                Text { text: "2. Disabled States"; font-weight: Theme.typography.header_weight; }
                
                HorizontalLayout {
                    spacing: Theme.spacing.lg;
                    Switch { disabled: true; }
                    Switch { disabled: true; checked: true; }
                }
            }
        }

        // Example 3: Events & Binding
        Card {
            VerticalLayout {
                spacing: Theme.spacing.md;
                Text { text: "3. Events & Binding"; font-weight: Theme.typography.header_weight; }
                
                property <bool> is-enabled: false;
                
                HorizontalLayout {
                    spacing: Theme.spacing.lg;
                    alignment: start;
                    Switch { 
                        checked: is-enabled;
                        toggled(val) => { is-enabled = val; }
                    }
                    Text {
                        text: is-enabled ? "Feature: Enabled" : "Feature: Disabled";
                        color: is-enabled ? Theme.palette.success : Theme.palette.text_secondary;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
