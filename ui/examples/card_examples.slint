import { Card } from "../components/card.slint";
import { Button } from "../components/button.slint";
import { Theme } from "../tokens.slint";

export component CardExamples inherits Rectangle {
    in property <bool> active: true;

    VerticalLayout {
        padding: Theme.spacing.lg;
        spacing: Theme.spacing.xl;
        alignment: start;

        // Example 1: Basic Card
        Card {
            title: "Basic Card";
            description: "This is a basic card with a title and a description. Cards are useful to group related content together.";
            
            // Empty body
        }

        // Example 2: Interactive Card
        Card {
            interactive: true;
            title: "Interactive Card";
            description: "Hover or click me to see interactive states.";
            
            clicked => {
                // handle click
            }
        }

        // Example 3: Card with Content
        Card {
            title: "Card with Custom Content";
            description: "Cards can hold any components inside their body.";
            
            VerticalLayout {
                spacing: Theme.spacing.md;
                
                Rectangle {
                    height: 100px;
                    background: Theme.palette.primary.with-alpha(0.2);
                    border-radius: Theme.spacing.sm;
                    Text { text: "Image Placeholder"; color: Theme.palette.primary; horizontal-alignment: center; vertical-alignment: center; }
                }
                
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.spacing.sm;
                    Button { text: "Cancel"; outlined: true; }
                    Button { text: "Submit"; }
                }
            }
        }
    }
}
