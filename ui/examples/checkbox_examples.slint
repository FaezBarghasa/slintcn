import { Checkbox } from "../components/checkbox.slint";
import { Card } from "../components/card.slint";
import { Theme } from "../tokens.slint";

export component CheckboxExamples inherits Rectangle {
    in property <bool> active: true;

    VerticalLayout {
        padding: Theme.spacing.lg;
        spacing: Theme.spacing.xl;
        alignment: start;

        // Example 1: Basic Checkboxes
        Card {
            VerticalLayout {
                spacing: Theme.spacing.md;
                Text { text: "1. Basic Checkboxes & Text"; font-weight: Theme.typography.header_weight; }
                
                HorizontalLayout {
                    spacing: Theme.spacing.lg;
                    Checkbox { text: "Apple"; }
                    Checkbox { text: "Banana"; checked: true; }
                    Checkbox { text: "Orange"; }
                }
            }
        }

        // Example 2: Disabled States
        Card {
            VerticalLayout {
                spacing: Theme.spacing.md;
                Text { text: "2. Disabled States"; font-weight: Theme.typography.header_weight; }
                
                HorizontalLayout {
                    spacing: Theme.spacing.lg;
                    Checkbox { text: "Disabled Unchecked"; disabled: true; }
                    Checkbox { text: "Disabled Checked"; disabled: true; checked: true; }
                }
            }
        }

        // Example 3: Events & Binding
        Card {
            VerticalLayout {
                spacing: Theme.spacing.md;
                Text { text: "3. Events & Binding"; font-weight: Theme.typography.header_weight; }
                
                property <bool> user-agreed: false;
                
                HorizontalLayout {
                    spacing: Theme.spacing.lg;
                    alignment: start;
                    Checkbox { 
                        text: "I agree to the terms";
                        checked: user-agreed;
                        toggled(val) => { user-agreed = val; }
                    }
                    Text {
                        text: user-agreed ? "Status: Agreed" : "Status: Pending";
                        color: user-agreed ? Theme.palette.success : Theme.palette.warning;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
