import { Theme } from "../tokens.slint";

export component Skeleton {
    in property <bool> is-circle: false;
    in property <length> border-radius: Theme.radius.md;
    
    width: 100%;
    height: 100%;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.is-circle ? min(root.width, root.height) / 2 : root.border-radius;
        background: Theme.palette.surface-variant;
        opacity: 0.7;
    }
}
