import { Theme } from "../tokens.slint";

export component RadioGroup {
    in property <[string]> options;
    in-out property <int> selected-index: -1;
    in property <bool> disabled: false;

    callback selected(int, string);

    VerticalLayout {
        spacing: Theme.spacing.sm;
        alignment: start;

        for option[index] in root.options : HorizontalLayout {
            spacing: Theme.spacing.sm;
            alignment: start;

            indicator := Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                border-width: 1.5px;
                border-color: root.selected-index == index ? Theme.palette.primary : Theme.palette.border;
                background: transparent;

                // Inner selection dot
                if root.selected-index == index : Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.disabled ? Theme.palette.text_disabled : Theme.palette.primary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            txt := Text {
                text: option;
                color: root.disabled ? Theme.palette.text_disabled : Theme.palette.text_primary;
                font-family: Theme.typography.font_family;
                font-size: Theme.typography.body_size;
                font-weight: Theme.typography.body_weight;
                vertical-alignment: center;
            }

            TouchArea {
                enabled: !root.disabled;
                clicked => {
                    root.selected-index = index;
                    root.selected(index, option);
                }
            }
        }
    }
}
