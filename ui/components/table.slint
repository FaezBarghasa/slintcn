import { Theme } from "../tokens.slint";
import { ScrollView } from "std-widgets.slint";

export struct TableColumn {
    title: string,
    width: length,
}

export component Table {
    in property <[TableColumn]> columns: [];
    in property <[[string]]> data: [];

    width: 100%;
    height: 100%;

    Rectangle {
        border-radius: Theme.spacing.sm;
        border-width: 1px;
        border-color: Theme.palette.border;
        background: Theme.palette.surface;
        clip: true;

        VerticalLayout {
            // Header
            Rectangle {
                height: 40px;
                background: Theme.palette.surface_raised;
                border-width: 1px;
                border-color: Theme.palette.border;

                HorizontalLayout {
                    for col in root.columns : Rectangle {
                        width: col.width;
                        padding-left: Theme.spacing.md;
                        Text {
                            text: col.title;
                            font-family: Theme.typography.font_family;
                            font-size: Theme.typography.body_size;
                            font-weight: Theme.typography.header_weight;
                            color: Theme.palette.text_secondary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Body
            ScrollView {
                VerticalLayout {
                    for row[i] in root.data : Rectangle {
                        height: 40px;
                        background: ta.has-hover ? Theme.palette.hover_overlay : transparent;
                        
                        Rectangle {
                            y: parent.height - 1px;
                            width: 100%;
                            height: 1px;
                            background: Theme.palette.border;
                        }

                        HorizontalLayout {
                            for cell[j] in row : Rectangle {
                                // Fallback to 100px if column index is missing
                                width: j < root.columns.length ? root.columns[j].width : 100px;
                                padding-left: Theme.spacing.md;
                                Text {
                                    text: cell;
                                    font-family: Theme.typography.font_family;
                                    font-size: Theme.typography.body_size;
                                    color: Theme.palette.text_primary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        ta := TouchArea {}
                    }
                }
            }
        }
    }
}
