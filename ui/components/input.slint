import { LineEdit } from "std-widgets.slint";
import { Theme } from "../tokens.slint";

export component Input inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text <=> input.placeholder-text;
    in property <bool> enabled <=> input.enabled;
    out property <bool> has-focus: input.has-focus;

    in property <string> label;
    in property <bool> has-error: false;
    in property <string> error-text: "";

    height: layout.preferred-height;
    forward-focus: input;

    layout := VerticalLayout {
        spacing: 4px;
        alignment: start;

        if root.label != "" : Text {
            text: root.label;
            color: root.has-error ? Theme.palette.critical : Theme.palette.text_secondary;
            font-family: Theme.typography.font_family;
            font-size: Theme.typography.caption_size;
            font-weight: Theme.typography.caption_weight;
        }

        Rectangle {
            height: 36px;
            
            input := LineEdit {
                width: 100%;
                height: 100%;
            }

            // Error border overlay
            Rectangle {
                width: 100%;
                height: 100%;
                border-color: root.has-error ? Theme.palette.critical : transparent;
                border-width: 1.5px;
                border-radius: 4px;
            }
        }

        if root.has-error : Text {
            text: root.error-text;
            color: Theme.palette.critical;
            font-family: Theme.typography.font_family;
            font-size: Theme.typography.caption_size;
            font-weight: Theme.typography.caption_weight;
        }
    }
}
