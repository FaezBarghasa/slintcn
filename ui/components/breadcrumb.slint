import { Theme } from "../tokens.slint";

export component BreadcrumbItem {
    in property <string> text: "";
    in property <bool> is-last: false;
    
    callback clicked();
    
    HorizontalLayout {
        spacing: Theme.spacing.xs;
        
        TouchArea {
            clicked => { root.clicked(); }
            Text {
                text: root.text;
                font-family: Theme.typography.font_family;
                font-size: Theme.typography.body_size;
                color: root.is-last ? Theme.palette.text_primary : Theme.palette.text_secondary;
                font-weight: root.is-last ? Theme.typography.header_weight : Theme.typography.body_weight;
            }
        }
        
        if (!root.is-last) : Text {
            text: "/";
            font-family: Theme.typography.font_family;
            font-size: Theme.typography.body_size;
            color: Theme.palette.text_secondary;
        }
    }
}

export component Breadcrumb {
    HorizontalLayout {
        spacing: Theme.spacing.xs;
        @children
    }
}
